
{
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.(html|css|js|jsx|ts|tsx|php|json|md)$",
                "isAsync": false,
                "cmd": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\auto-push.ps1\"",
                "message": "Uploading changes to GitHub..."
            }
        ]
    }
}
